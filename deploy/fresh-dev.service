[Unit]
Description=Fresh Quiz (dev)
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/fresh/app-dev
EnvironmentFile=/opt/fresh/app-dev/.env
ExecStart=/usr/local/bin/deno serve -A --host 0.0.0.0 --port 8001 _fresh/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
